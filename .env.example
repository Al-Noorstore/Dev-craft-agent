# ============================================
# Vercel Dashboard > Settings > Environment Variables
# ============================================

# 1. AI BRAIN (chat/score/draft/email classification) - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# 2. BUSINESS SEARCH - console.cloud.google.com > Places API enable
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxx

# 3. WHATSAPP BOT - developers.facebook.com > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=my_secret_verify_123

# 4. SEND EMAIL (Gmail SMTP) - Google Account > Security > 2-Step > App Passwords
EMAIL_USER=yourgmail@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 5. READ INBOX (Gmail OAuth) - Google Cloud Console > OAuth client > Gmail API
GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxx

# 6. SUPABASE (leads database) - supabase.com (free)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxx

# 7. DAILY REPORT receiver
REPORT_EMAIL=yourgmail@gmail.com

# ============ NEW TOOLS (v4) ============

# 8. STRIPE (payment links) - dashboard.stripe.com/apikeys
# PEHLE sk_test_... (test) key use karo, phir live!
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxx

# 9. GOOGLE SHEETS - console.cloud.google.com > Service Account > JSON key
GOOGLE_SHEETS_CLIENT_EMAIL=sheets-bot@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1Bxac...sheet-id-from-url

# 10. NOTION - notion.so/my-integrations > integration token
NOTION_TOKEN=secret_xxxxxxxxxxxx
NOTION_DATABASE_ID=32char_database_id_from_url

# 11. TWITTER/X - developer.x.com (NOTE: search ke liye $100/mo Basic plan chahiye)
TWITTER_BEARER_TOKEN=AAAAAAAAxxxxxxxx

# 12. SLACK - api.slack.com/messaging/webhooks > Incoming Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# 13. DISCORD - Server > Channel > Integrations > Webhooks > New
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/XXXX

# 14. TELEGRAM BOT - @BotFather se /newbot karo, token milega (FREE - sabse asaan!)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxx

# 15. GOOGLE DRIVE - Service Account (Sheets jaisa hi) + Drive API enable karo
# Folder bana kar service account email ko share karo, folder ID URL se lo
GOOGLE_DRIVE_CLIENT_EMAIL=drive-bot@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=1AbCdefGhIjKlMnOpQrStUvWxYz

# 16. GITHUB - github.com > Settings > Developer settings > Personal access tokens (repo scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxx

# 17. GITLAB - gitlab.com > Preferences > Access Tokens (api scope)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx
# Self-hosted GitLab ho to (default gitlab.com):
# GITLAB_API_URL=https://gitlab.example.com
